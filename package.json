{
  "name": "bizsamadhan-platform",
  "version": "1.0.0",
  "description": "Wadhwani Associates legal services platform with Express, Prisma, PostgreSQL, and a Next.js frontend.",
  "main": "backend/server.js",
  "scripts": {
    "start": "npm run start:railway",
    "start:railway": "npm run prisma:generate && npm run prisma:db:push && node backend/server.js",
    "dev": "node --watch backend/server.js",
    "worker": "node backend/worker.js",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema=./prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema=./prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "prisma:db:push": "prisma db push --schema=./prisma/schema.prisma",
    "install:scaled:deps": "powershell -ExecutionPolicy Bypass -File backend/scripts/installLocalScaleDependencies.ps1",
    "check:scaled": "set \"ENV_FILE=backend/.env.scaled.local\" && node backend/scripts/checkScaledDependencies.js",
    "start:scaled": "set \"ENV_FILE=backend/.env.scaled.local\" && node backend/server.js",
    "worker:scaled": "set \"ENV_FILE=backend/.env.scaled.local\" && node backend/worker.js",
    "healthcheck": "node backend/scripts/healthcheck.js",
    "docker:up:prod": "docker compose -f docker-compose.production.yml up --build -d",
    "docker:down:prod": "docker compose -f docker-compose.production.yml down",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:logs": "pm2 logs"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.170",
    "@aws-sdk/client-s3": "^3.940.0",
    "@aws-sdk/s3-request-presigner": "^3.940.0",
    "@prisma/client": "^6.19.3",
    "ai": "^6.0.168",
    "bullmq": "^5.61.0",
    "cmdk": "^1.1.1",
    "compression": "^1.8.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "framer-motion": "^12.38.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.8.0",
    "multer": "^2.1.1",
    "next": "^16.2.4",
    "pdfkit": "^0.15.1",
    "pm2": "^6.0.14",
    "prisma": "^6.19.3",
    "razorpay": "^2.9.6",
    "react": "^19.2.5",
    "resend": "^6.10.0",
    "zod": "^4.3.6"
  }
}
